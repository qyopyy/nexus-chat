;; Jail for cloudflared (deploy/macos/run-tunnel.sh).
;; Reads under /Users: its scripts, tunnel.env (CLOUDFLARE_TUNNEL_TOKEN only) and ~/.cloudflared
;; (this tunnel's config and credential), not the server's secrets. Execs: bash, date and
;; cloudflared only. Network: on loopback only the web server; the internet is not restricted
;; (Seatbelt cannot filter by host name).
;; Parameters: REPO, HOME, CONFIG_DIR, CLOUDFLARED, HTTP_PORT.
(import (string-append (param "REPO") "/deploy/macos/sandbox/common.sb"))

(allow file-read*
  (subpath (repo-path "deploy/macos"))
  (literal (config-path "tunnel.env"))
  (subpath (string-append (param "HOME") "/.cloudflared")))
(allow file-read-metadata (literal (repo-path "deploy")) (literal (param "CONFIG_DIR")))

(allow process-exec*
  (literal "/bin/bash")
  (literal "/bin/date")
  (literal (param "CLOUDFLARED")))
(deny network-outbound (remote unix-socket))
(allow network-outbound (remote unix-socket (path-literal "/private/var/run/mDNSResponder")))
;; Seatbelt applies the last matching rule: the loopback rules come after the Unix-socket ones.
(deny network-outbound (remote ip "localhost:*"))
(allow network-outbound (remote ip (string-append "localhost:" (param "HTTP_PORT"))))
