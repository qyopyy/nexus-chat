<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- cloudflared inside its Seatbelt jail, forwarding only to the web server. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL_PREFIX@.tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/sandbox-exec</string>
    <string>-D</string><string>REPO=@REPO@</string>
    <string>-D</string><string>HOME=@HOME@</string>
    <string>-D</string><string>CONFIG_DIR=@CONFIG_DIR@</string>
    <string>-D</string><string>CLOUDFLARED=@CLOUDFLARED@</string>
    <string>-D</string><string>HTTP_PORT=@HTTP_PORT@</string>
    <string>-f</string><string>@REPO@/deploy/macos/sandbox/tunnel.sb</string>
    <string>/bin/bash</string>
    <string>@REPO@/deploy/macos/run-tunnel.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@SERVICE_PATH@</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>@REPO@</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>@LOG_DIR@/@NAME@.log</string>
  <key>StandardErrorPath</key>
  <string>@LOG_DIR@/@NAME@.log</string>
</dict>
</plist>
