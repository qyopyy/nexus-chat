{
  "name": "bump-mobile",
  "version": "1.2.0",
  "private": true,
  "description": "Standalone Wump iOS/Android shell (Capacitor). Loads the live Wump web app \u2014 same Nexus backend, separate home-screen icon.",
  "scripts": {
    "sync": "npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "patch:ios-plist": "python3 scripts/patch-ios-info-plist.py",
    "sync:ios": "npx cap sync ios && python3 scripts/patch-ios-info-plist.py"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@capacitor-community/background-geolocation": "^1.2.27",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capawesome/capacitor-badge": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^5.9.3"
  }
}
