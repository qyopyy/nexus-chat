diff --git a/gui/include/netinput.h b/gui/include/netinput.h
new file mode 100644
index 0000000..7cfed33
--- /dev/null
+++ b/gui/include/netinput.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#ifndef CHIAKI_NETINPUT_H
+#define CHIAKI_NETINPUT_H
+
+#include <chiaki/controller.h>
+
+#include <QElapsedTimer>
+#include <QObject>
+
+class QUdpSocket;
+class QTimer;
+
+/**
+ * Network controller input for remote "crowd play" setups.
+ *
+ * Disabled unless the CHIAKI_NET_INPUT_PORT environment variable is set. When enabled,
+ * it listens on 127.0.0.1 only for UDP datagrams carrying a full controller state as JSON:
+ *   {"v":1,"buttons":<ChiakiControllerButton mask>,"l2":0-255,"r2":0-255,
+ *    "lx":-32767..32767,"ly":...,"rx":...,"ry":...}
+ * Senders repeat the state periodically; if nothing arrives for NET_INPUT_TIMEOUT_MS
+ * the state falls back to idle, so a crashed sender never leaves a button held.
+ *
+ * {"request":"keyframe"} asks the console for a video keyframe (KeyframeRequested) and leaves
+ * the controller state alone; requests closer than NET_INPUT_KEYFRAME_MIN_MS are dropped.
+ */
+class NetInput : public QObject
+{
+	Q_OBJECT
+
+	public:
+		static constexpr int NET_INPUT_TIMEOUT_MS = 500;
+		/** Every keyframe makes the console skip a few frames: whoever sends, at most one per second. */
+		static constexpr int NET_INPUT_KEYFRAME_MIN_MS = 1000;
+
+		explicit NetInput(QObject *parent = nullptr);
+
+		bool IsEnabled() const { return socket != nullptr; }
+		ChiakiControllerState GetState() const { return state; }
+
+		/** @return false (leaving out untouched) when data is not a valid v1 packet. */
+		static bool ParsePacket(const QByteArray &data, ChiakiControllerState *out);
+		/** @return true when data is a {"request":"keyframe"} packet. */
+		static bool IsKeyframeRequest(const QByteArray &data);
+
+	signals:
+		void StateChanged();
+		void KeyframeRequested();
+
+	private:
+		void ReadPendingDatagrams();
+		void SetState(const ChiakiControllerState &new_state);
+
+		QUdpSocket *socket = nullptr;
+		QTimer *watchdog = nullptr;
+		QElapsedTimer last_keyframe_request;
+		ChiakiControllerState state;
+};
+
+#endif // CHIAKI_NETINPUT_H
