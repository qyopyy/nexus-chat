diff --git a/gui/src/netinput.cpp b/gui/src/netinput.cpp
new file mode 100644
index 0000000..5c6754a
--- /dev/null
+++ b/gui/src/netinput.cpp
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#include "netinput.h"
+
+#include <QHostAddress>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QNetworkDatagram>
+#include <QTimer>
+#include <QUdpSocket>
+#include <QtGlobal>
+
+// PS and Create (Share) never reach the console, whoever sends to the input port: they open the
+// console's own menus (home screen, capture and broadcast), outside the game. The server already
+// clears them; this also covers any other local process. Fixed at build time on purpose.
+static const uint32_t NET_INPUT_BLOCKED_BUTTONS = CHIAKI_CONTROLLER_BUTTON_PS | CHIAKI_CONTROLLER_BUTTON_SHARE;
+static const uint32_t NET_INPUT_DIGITAL_BUTTONS_MASK =
+	((1u << CHIAKI_CONTROLLER_BUTTONS_COUNT) - 1) & ~NET_INPUT_BLOCKED_BUTTONS;
+
+NetInput::NetInput(QObject *parent) : QObject(parent)
+{
+	chiaki_controller_state_set_idle(&state);
+
+	if(!qEnvironmentVariableIsSet("CHIAKI_NET_INPUT_PORT"))
+		return;
+
+	bool ok = false;
+	quint16 port = qEnvironmentVariable("CHIAKI_NET_INPUT_PORT").toUShort(&ok);
+	if(!ok || port == 0)
+	{
+		qWarning() << "NetInput: invalid CHIAKI_NET_INPUT_PORT, network input disabled";
+		return;
+	}
+
+	socket = new QUdpSocket(this);
+	if(!socket->bind(QHostAddress::LocalHost, port))
+	{
+		qWarning() << "NetInput: cannot bind 127.0.0.1:" << port << "-" << socket->errorString();
+		delete socket;
+		socket = nullptr;
+		return;
+	}
+	qInfo() << "NetInput: listening for controller input on 127.0.0.1:" << port;
+
+	watchdog = new QTimer(this);
+	watchdog->setSingleShot(true);
+	watchdog->setInterval(NET_INPUT_TIMEOUT_MS);
+	connect(watchdog, &QTimer::timeout, this, [this] {
+		ChiakiControllerState idle;
+		chiaki_controller_state_set_idle(&idle);
+		SetState(idle);
+	});
+	connect(socket, &QUdpSocket::readyRead, this, &NetInput::ReadPendingDatagrams);
+}
+
+bool NetInput::ParsePacket(const QByteArray &data, ChiakiControllerState *out)
+{
+	QJsonParseError error;
+	QJsonDocument doc = QJsonDocument::fromJson(data, &error);
+	if(error.error != QJsonParseError::NoError || !doc.isObject())
+		return false;
+
+	QJsonObject obj = doc.object();
+	if(obj.value("v").toInt() != 1)
+		return false;
+
+	auto axis = [&obj](const char *key) {
+		return static_cast<int16_t>(qBound(-32767, obj.value(key).toInt(), 32767));
+	};
+	auto trigger = [&obj](const char *key) {
+		return static_cast<uint8_t>(qBound(0, obj.value(key).toInt(), 255));
+	};
+
+	ChiakiControllerState parsed;
+	chiaki_controller_state_set_idle(&parsed);
+	parsed.buttons = static_cast<uint32_t>(obj.value("buttons").toInteger()) & NET_INPUT_DIGITAL_BUTTONS_MASK;
+	parsed.l2_state = trigger("l2");
+	parsed.r2_state = trigger("r2");
+	parsed.left_x = axis("lx");
+	parsed.left_y = axis("ly");
+	parsed.right_x = axis("rx");
+	parsed.right_y = axis("ry");
+	*out = parsed;
+	return true;
+}
+
+bool NetInput::IsKeyframeRequest(const QByteArray &data)
+{
+	QJsonParseError error;
+	QJsonDocument doc = QJsonDocument::fromJson(data, &error);
+	return error.error == QJsonParseError::NoError && doc.isObject()
+		&& doc.object().value("request").toString() == QStringLiteral("keyframe");
+}
+
+void NetInput::ReadPendingDatagrams()
+{
+	while(socket->hasPendingDatagrams())
+	{
+		QNetworkDatagram datagram = socket->receiveDatagram();
+		if(IsKeyframeRequest(datagram.data()))
+		{
+			if(!last_keyframe_request.isValid() || last_keyframe_request.elapsed() >= NET_INPUT_KEYFRAME_MIN_MS)
+			{
+				last_keyframe_request.start();
+				emit KeyframeRequested();
+			}
+			continue;
+		}
+		ChiakiControllerState parsed;
+		if(!ParsePacket(datagram.data(), &parsed))
+			continue;
+		watchdog->start();
+		SetState(parsed);
+	}
+}
+
+void NetInput::SetState(const ChiakiControllerState &new_state)
+{
+	ChiakiControllerState candidate = new_state;
+	if(chiaki_controller_state_equals(&state, &candidate))
+		return;
+	state = candidate;
+	emit StateChanged();
+}
