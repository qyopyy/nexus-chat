+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+#ifndef CHIAKI_STREAMOUT_H
+#define CHIAKI_STREAMOUT_H
+
+#include <chiaki/common.h>
+#include <chiaki/log.h>
+
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <climits>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+struct AVFormatContext;
+
+struct FrameClockConfig
+{
+	int64_t duration_num = 1000000, duration_den = 30; // frame duration = num / den µs
+	int64_t max_late_us = 300 * 1000;
+	int64_t steer_window_us = 2000 * 1000;
+	int64_t steer_deadband_us = 2000; // smaller sustained delays are left alone
+	int64_t steer_percent = 3; // largest upward step per frame, in percent of a frame
+};
+
+/**
+ * Presentation times for a stream of fixed-duration frames that carry a frame counter (the
+ * console's video frame index, or a count of audio frames).
+ *
+ * Stamping by arrival time bakes the network's jitter into the timestamps: a frame that is
+ * 120 ms late over Wi-Fi gets a timestamp 120 ms late, and the browser pauses on it even with
+ * a jitter buffer. This clock lays frames out by their counter instead,
+ *   pts = counter * duration + offset,
+ * so a late frame keeps its slot and lost frames leave a gap of the right size. The offset
+ * follows the earliest arrivals (pts never runs ahead of the arrival clock, which keeps
+ * MediaMTX's NTP estimate and A/V sync on one clock):
+ * - a frame that arrives before its slot moves the offset down to it at once;
+ * - when the earliest arrival of a whole window is later than its slot (the console's clock
+ *   runs slower than ours, or the route got slower) the offset steers up, a few percent of a
+ *   frame per frame;
+ * - a frame more than max_late_us behind its slot (a long stall, a restarted counter) re-anchors
+ *   the clock on it, so the delay this adds is bounded.
+ * Timestamps are strictly increasing. All times are in microseconds.
+ */
+class FrameClock
+{
+	public:
+		using Config = FrameClockConfig;
+
+		explicit FrameClock(const Config &config = Config()) : config(config) {}
+
+		void Reset() { *this = FrameClock(config); }
+
+		/** @param counter frame counter, increasing (a counter going back is treated as a restart) */
+		int64_t Stamp(int64_t counter, int64_t arrival_us)
+		{
+			if(started && counter + shift <= last_counter)
+				shift = last_counter + 1 - counter; // restarted counter: carry on after the last frame
+			counter += shift;
+			int64_t slot = counter * config.duration_num / config.duration_den;
+			int64_t raw = arrival_us - slot; // offset that would put this frame at its arrival time
+			if(!started)
+			{
+				started = true;
+				offset = target = raw;
+				window_start_us = arrival_us;
+				window_min = raw;
+				last_pts = INT64_MIN;
+			}
+			else if(raw < offset)
+				offset = target = raw; // early: our slots were late
+			else if(raw - offset > config.max_late_us)
+			{
+				offset = target = raw; // a long stall: give up on the old slots
+				resyncs++;
+			}
+
+			window_min = std::min(window_min, raw);
+			if(arrival_us - window_start_us >= config.steer_window_us)
+			{
+				if(window_min > offset + config.steer_deadband_us)
+					target = window_min; // even the earliest frames arrived late
+				window_start_us = arrival_us;
+				window_min = raw;
+			}
+			if(target > offset)
+			{
+				int64_t step = std::max<int64_t>(1, config.duration_num * config.steer_percent / (config.duration_den * 100));
+				offset = std::min({target, offset + step, raw});
+			}
+
+			int64_t pts = slot + offset;
+			if(pts <= last_pts)
+				pts = last_pts + 1;
+			last_pts = pts;
+			last_counter = counter;
+			return pts;
+		}
+
+		/** Times a frame was too late and the clock re-anchored. */
+		uint64_t Resyncs() const { return resyncs; }
+
+	private:
+		Config config;
+		bool started = false;
+		int64_t shift = 0, last_counter = 0;
+		int64_t offset = 0, target = 0;
+		int64_t window_start_us = 0, window_min = 0;
+		int64_t last_pts = 0;
+		uint64_t resyncs = 0;
+};
+
+/** Extends a 16-bit sequence number (the console's frame index) to 64 bits across wraparound. */
+class SeqUnwrapper16
+{
+	public:
+		int64_t Unwrap(uint16_t seq)
+		{
+			if(!started)
+			{
+				started = true;
+				value = seq;
+			}
+			else
+				value += (int16_t)(uint16_t)(seq - last);
+			last = seq;
+			return value;
+		}
+
+	private:
+		bool started = false;
+		uint16_t last = 0;
+		int64_t value = 0;
+};
+
+/**
+ * Forwards the console's own encoded stream to a local media server, without re-encoding.
+ *
+ * Disabled unless the CHIAKI_STREAM_OUT_URL environment variable is set, e.g.
+ *   CHIAKI_STREAM_OUT_URL=rtsp://127.0.0.1:8554/console
+ * The H.264 video samples and the raw Opus audio frames chiaki receives are published as-is
+ * over RTSP (RTP over TCP). Video is timestamped by the console's frame index and audio by its
+ * sample count (see FrameClock), so Wi-Fi jitter stays out of the timestamps and the browser's
+ * jitter buffer can absorb it; both clocks follow the arrival clock within
+ * FrameClockConfig::max_late_us, which keeps them in sync. Only H.264 is
+ * forwarded: browsers cannot reliably play HEVC over WebRTC, so an HEVC session logs a
+ * warning and publishes nothing.
+ *
+ * Push*() never blocks on the network: packets go to a small queue that a worker thread
+ * writes out. While the server is unreachable nothing is queued and the worker retries
+ * every second; when the queue overflows the oldest packets are dropped. After any gap the
+ * video resumes on the next keyframe, which is requested from the console through the
+ * request_idr callback (also every CHIAKI_STREAM_OUT_IDR_MS, default 10000, as a safety net:
+ * the server asks for keyframes on demand through NetInput, since each one costs a hitch).
+ */
+class StreamOut
+{
+	public:
+		using IdrRequest = std::function<void()>;
+
+		struct Options
+		{
+			std::string url;
+			ChiakiCodec codec = CHIAKI_CODEC_H264;
+			int width = 1920, height = 1080; // negotiated resolution (the muxer requires one)
+			int fps = 30;                    // negotiated frame rate: one frame index step
+			int idr_interval_ms = 10000;
+			size_t queue_max = 64;
+			int reconnect_ms = 1000;
+		};
+
+		struct Stats
+		{
+			uint64_t video_in = 0;        // samples handed to PushVideo (headers excluded)
+			uint64_t video_out = 0;       // video packets written to the server
+			uint64_t video_skipped = 0;   // dropped while waiting for a keyframe
+			uint64_t audio_out = 0;       // audio packets written to the server
+			uint64_t queue_dropped = 0;   // dropped because the queue was full
+			uint64_t connects = 0;        // successful connections
+			uint64_t idr_requests = 0;
+			uint64_t max_push_us = 0;     // slowest Push*() call
+			uint64_t video_resyncs = 0;   // video frames too late for their slot: clock re-anchored
+			uint64_t audio_resyncs = 0;   // same for audio
+			bool refused = false;         // stream is not H.264: nothing is published
+		};
+
+		/** @return nullptr unless CHIAKI_STREAM_OUT_URL is set. */
+		static StreamOut *FromEnvironment(ChiakiLog *log, ChiakiCodec codec, int width, int height, int fps, IdrRequest request_idr);
+
+		StreamOut(const Options &options, ChiakiLog *log, IdrRequest request_idr);
+		~StreamOut();
+		StreamOut(const StreamOut &) = delete;
+		StreamOut &operator=(const StreamOut &) = delete;
+
+		/**
+		 * Same arguments as ChiakiVideoSampleCallback, plus the console's index of this frame
+		 * (ChiakiVideoReceiver::frame_index_cur; negative = unknown: stamped by arrival).
+		 * Call from the video receiver thread.
+		 */
+		void PushVideo(const uint8_t *buf, size_t buf_size, int32_t frames_lost, bool frame_recovered, int32_t frame_index = -1);
+		/** Same values as the ChiakiAudioSink header callback. */
+		void SetAudioHeader(unsigned channels, unsigned rate, unsigned frame_size);
+		/** One raw Opus frame, as given to the ChiakiAudioSink frame callback (empty = lost). */
+		void PushAudio(const uint8_t *buf, size_t buf_size);
+
+		bool IsConnected() const { return connected.load(); }
+		Stats GetStats();
+
+		/** Exposed for tests. */
+		static bool IsH264Keyframe(const uint8_t *buf, size_t size);
+		static bool IsH264Header(const uint8_t *buf, size_t size);
+		static bool HasH264Slice(const uint8_t *buf, size_t size);
+
+	private:
+		struct Packet
+		{
+			bool video;
+			bool key;
+			int64_t arrival_us;
+			int64_t counter; // unwrapped video frame index or audio frame count; -1 = none
+			std::vector<uint8_t> data;
+		};
+
+		void Run();
+		bool Connect();
+		void Disconnect();
+		bool Write(Packet &packet);
+		void Enqueue(Packet &&packet);
+		void NotePushTime(int64_t started_us);
+		static int InterruptCb(void *opaque);
+
+		Options options;
+		ChiakiLog *log;
+		IdrRequest request_idr;
+
+		std::mutex mutex;
+		std::condition_variable cond;
+		std::deque<Packet> queue;
+		bool stop = false;
+		bool video_gap = false;          // a queued video packet was dropped
+		bool reconnect = false;          // stream parameters changed
+		std::vector<uint8_t> video_header; // SPS + PPS, Annex B
+		unsigned audio_channels = 0, audio_rate = 0, audio_frame_size = 0;
+		Stats stats;
+
+		std::atomic<bool> connected{false};
+		std::atomic<bool> want_keyframe{false};
+		std::atomic<bool> refused{false};
+		std::atomic<int64_t> deadline_us{0};
+		std::atomic<bool> timed_out{false}; // the interrupt callback cut a network operation short
+		int64_t last_idr_request_us = 0; // video thread only
+		int64_t last_keyframe_us = 0;    // video thread only
+		SeqUnwrapper16 frame_index_unwrap; // video thread only
+		int64_t audio_frames = 0;        // audio thread only: frames seen, lost ones included
+
+		// Worker thread only.
+		AVFormatContext *ctx = nullptr;
+		int video_index = -1, audio_index = -1;
+		int64_t base_us = -1, last_video_pts = -1, last_audio_pts = -1;
+		FrameClock video_clock, audio_clock;
+		bool need_keyframe = true;
+
+		std::thread worker;
+};
+
+#endif // CHIAKI_STREAMOUT_H
