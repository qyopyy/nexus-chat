{
  "name": "nexus-mobile",
  "version": "1.8.0",
  "private": true,
  "description": "Native iOS + Android shells for Nexus (Capacitor). The apps load the live web app, so web deploys update them instantly.",
  "scripts": {
    "sync": "npx cap sync",
    "sync:ios": "npx cap sync ios && python3 scripts/patch-ios-info-plist.py",
    "patch:ios-plist": "python3 scripts/patch-ios-info-plist.py",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capawesome/capacitor-badge": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^5.9.3"
  }
}
