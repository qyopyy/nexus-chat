# Copy to .env.local. Names only — leave secrets out of git.
# NEXT_PUBLIC_ values are sent to the browser. Everything else stays on the server.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs Acetate share playback. Never expose this in the client.
SUPABASE_SERVICE_ROLE_KEY=

# Spotify link import. When both are unset, Acetate uses Spotify oEmbed and does not list album or playlist tracks.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube playlist and duration lookup. Single videos still resolve through oEmbed when this is unset.
YOUTUBE_API_KEY=

# SoundCloud OAuth for the official API. Both are required. Audio import stays off with a
# "SoundCloud not configured" state until they exist. Register the redirect URI on the SoundCloud app.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
# Optional. Defaults to {this site}/api/acetate/soundcloud/callback
SOUNDCLOUD_REDIRECT_URI=
