{
  "manifest_version": 3,
  "name": "Nexus Safari Manager",
  "description": "Shields presets and Nexus site helpers for Safari, managed by the Nexus Safari Manager Mac app.",
  "version": "1.0.0",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["*://nexusproject.cc/*", "*://*.nexusproject.cc/*", "*://localhost/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/toolbar-icon-16.png",
      "19": "images/toolbar-icon-19.png",
      "32": "images/toolbar-icon-32.png",
      "38": "images/toolbar-icon-38.png"
    }
  },
  "permissions": ["storage", "nativeMessaging", "declarativeNetRequest", "tabs"],
  "host_permissions": ["*://nexusproject.cc/*", "*://*.nexusproject.cc/*", "*://*/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tracker_block",
        "enabled": true,
        "path": "rules/tracker_block.json"
      }
    ]
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.0"
    }
  }
}
